{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UI: Start",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/Taurit.TodoistTools.CalendarProxy.UI"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> ng serve$",
          "endsPattern": "Application bundle generation complete\\."
        }
      }
    },
    {
      "label": "UI: Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/Taurit.TodoistTools.CalendarProxy.UI"
      },
      "problemMatcher": []
    }
  ]
}
