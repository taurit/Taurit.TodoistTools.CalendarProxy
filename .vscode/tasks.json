{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UI: Start",
      "type": "process",
      "command": "python",
      "args": ["-u", "-m", "http.server", "4200", "--bind", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}/Taurit.TodoistTools.CalendarProxy.UI/src"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "calendarproxy-static-server",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*File \"([^\"]+)\", line (\\d+), in (.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*\\*\\s+Executing task:.*http\\.server",
          "endsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 4200 "
        }
      }
    }
  ]
}
